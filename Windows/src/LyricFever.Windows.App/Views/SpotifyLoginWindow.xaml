<Window x:Class="LyricFever.Windows.App.Views.SpotifyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Spotify 登录"
        Width="480" Height="680"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="WebView" Margin="0"/>
        <StackPanel Grid.Row="1" Margin="12,8,12,12">
            <TextBlock Text="登录页面不可用时，可手动粘贴浏览器中的 sp_dc Cookie 值："
                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="CookieInput" Width="320" VerticalContentAlignment="Center"/>
                <Button Content="保存 Cookie" Width="110" Margin="8,0,0,0"
                        Click="OnSaveCookieClicked"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
