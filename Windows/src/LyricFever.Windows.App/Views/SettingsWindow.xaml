<Window x:Class="LyricFever.Windows.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyric Fever 设置"
        Width="660" Height="500"
        MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="SettingsRoot" Background="{StaticResource WindowBackgroundBrush}">
        <TabControl x:Name="SettingsTabs" SelectedIndex="0"
                    Style="{StaticResource SettingsTabControlStyle}">
            <!-- 连接状态 -->
            <TabItem Header="状态" Tag="&#xE80F;" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="连接状态" Style="{StaticResource SettingsPageTitleStyle}"/>
                        <TextBlock Text="Lyric Fever 安静地监听 Apple Music，只负责同步歌词，不接管播放。"
                                   Style="{StaticResource SettingsPageSubtitleStyle}"/>

                        <Border Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="17" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaSessionStatusText" Text="正在检测 Apple Music"
                                               Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <TextBlock x:Name="NowPlayingText" Text="开始播放音乐后，字幕会自动出现"
                                               Margin="0,3,0,0" FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border x:Name="ConnectionBadge" Grid.Column="2"
                                        Background="{StaticResource SurfaceMutedBrush}"
                                        CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="MediaStatusDot" Width="6" Height="6"
                                                 Fill="{StaticResource TextTertiaryBrush}"
                                                 Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConnectionBadgeText" Text="等待中"
                                                   FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="只读监听" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="从 Windows 媒体会话读取曲目、进度和封面；播放操作始终留在 Apple Music。"
                                               Margin="0,7,0,0" Style="{StaticResource SettingsBodyStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="自动字幕" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="曲目变化时自动匹配同步歌词、人工中文译词和日文罗马音。"
                                               Margin="0,7,0,0" Style="{StaticResource SettingsBodyStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 网络歌词 -->
            <TabItem Header="歌词" Tag="&#xE8D6;" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="歌词与译词" Style="{StaticResource SettingsPageTitleStyle}"/>
                        <TextBlock Text="只使用经过曲目校验的网络歌词和人工译词，不调用本地机器翻译。"
                                   Style="{StaticResource SettingsPageSubtitleStyle}"/>

                        <Border Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="人工中文译词" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <TextBlock Text="优先采用与原文共用时间轴的平台人工译词；没有可靠结果时保持空白。"
                                               Margin="0,5,0,0" Style="{StaticResource SettingsBodyStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding TranslateEnabled}"
                                          Style="{StaticResource ModernToggleStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="日文罗马音" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <TextBlock Text="日文歌曲在原文下显示逐词罗马音；其他语言不会增加这一行。"
                                               Margin="0,5,0,0" Style="{StaticResource SettingsBodyStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding RomanizationEnabled}"
                                          Style="{StaticResource ModernToggleStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="来源顺序" Style="{StaticResource SettingsCardTitleStyle}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="1" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="网易云同源原文与人工译词" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="优先保证日文分句与中文翻译一一对应。" Margin="0,2,0,0"
                                                   Style="{StaticResource SettingsBodyStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource SurfaceMutedBrush}">
                                        <TextBlock Text="2" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="LRCLIB → 网易云同步原文兜底"
                                               Margin="8,1,0,0" FontSize="11.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 字幕外观 -->
            <TabItem Header="字幕" Tag="&#xE8A7;" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="字幕外观" Style="{StaticResource SettingsPageTitleStyle}"/>
                        <TextBlock Text="调整当前歌词卡片的字号、背景和时间同步。"
                                   Style="{StaticResource SettingsPageSubtitleStyle}"/>

                        <Border Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="字体大小" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource SettingsValuePillStyle}">
                                        <TextBlock Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:0} pt}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="FontSizeSlider" Margin="0,10,0,0"
                                        Minimum="12" Maximum="48" SmallChange="1" LargeChange="4"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding KaraokeFontSize}"
                                        Style="{StaticResource ModernSliderStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="背景不透明度" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource SettingsValuePillStyle}">
                                        <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="OpacitySlider" Margin="0,10,0,0"
                                        Minimum="0.5" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        Value="{Binding KaraokeOpacity}"
                                        Style="{StaticResource ModernSliderStyle}"/>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding KaraokeUseBackgroundColor}"
                                          Content="使用专辑封面色作为字幕背景"
                                          Style="{StaticResource ModernToggleStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="歌词时间偏移" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource SettingsValuePillStyle}">
                                        <TextBlock Text="{Binding ElementName=OffsetSlider, Path=Value, StringFormat={}{0:0} ms}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="正数会让歌词更早出现，负数会延后。" Margin="0,5,0,0"
                                           Style="{StaticResource SettingsBodyStyle}"/>
                                <Slider x:Name="OffsetSlider" Margin="0,8,0,0"
                                        Minimum="-2000" Maximum="2000" SmallChange="50" LargeChange="250"
                                        TickFrequency="50" IsSnapToTickEnabled="True"
                                        Value="{Binding LyricOffsetMs}"
                                        Style="{StaticResource ModernSliderStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通用 -->
            <TabItem Header="通用" Tag="&#xE713;" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,26">
                        <TextBlock Text="通用设置" Style="{StaticResource SettingsPageTitleStyle}"/>
                        <TextBlock Text="控制 Lyric Fever 如何随 Windows 启动，以及本地数据的位置。"
                                   Style="{StaticResource SettingsPageSubtitleStyle}"/>

                        <Border Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="登录 Windows 后自动启动" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <TextBlock Text="应用在后台进入系统托盘；检测到 Apple Music 播放后自动显示字幕。"
                                               Margin="0,5,0,0" Style="{StaticResource SettingsBodyStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtStartup}"
                                          Style="{StaticResource ModernToggleStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="本地数据" Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="歌词缓存、译词产物和设置保存在：" Margin="0,6,0,0"
                                           Style="{StaticResource SettingsBodyStyle}"/>
                                <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="7"
                                        Background="{StaticResource SurfaceMutedBrush}">
                                    <TextBlock x:Name="DataPathText" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="当前产品边界" Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Margin="0,7,0,0"
                                           Text="Apple Music 播放监听 · 网络同步歌词 · 人工中文译词 · 日文罗马音 · 悬浮字幕"
                                           Style="{StaticResource SettingsBodyStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
