<Window x:Class="LyricFever.Windows.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyric Fever 设置"
        Width="560" Height="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SettingLabel">
            <Setter Property="Margin" Value="0,6,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="0">
            <!-- 播放器 -->
            <TabItem Header="播放器">
                <StackPanel Margin="12">
                    <CheckBox IsChecked="{Binding UseSpotify}" Content="使用 Spotify 集成（SMTC）"/>
                    <TextBlock x:Name="SpotifyStatusText" Text="Spotify 登录状态：未登录"
                               Style="{StaticResource SettingLabel}"/>
                </StackPanel>
            </TabItem>

            <!-- 翻译 -->
            <TabItem Header="翻译">
                <StackPanel Margin="12">
                    <CheckBox IsChecked="{Binding TranslateEnabled}" Content="启用歌词翻译（本地模型）"/>
                    <TextBlock Text="源语言：" Style="{StaticResource SettingLabel}"/>
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding SourceLanguage}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="自动识别" Tag="auto"/>
                        <ComboBoxItem Content="英文" Tag="en"/>
                        <ComboBoxItem Content="日文" Tag="ja"/>
                    </ComboBox>
                    <TextBlock Text="目标语言固定为中文。模型按需加载，空闲自动卸载。"
                               Style="{StaticResource SettingLabel}" Foreground="Gray" FontSize="12"/>
                    <CheckBox IsChecked="{Binding RomanizationEnabled}" Content="日文歌词标注罗马音" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- K 歌 -->
            <TabItem Header="K 歌">
                <StackPanel Margin="12">
                    <TextBlock Text="字体大小" Style="{StaticResource SettingLabel}"/>
                    <Slider Minimum="12" Maximum="48" Value="{Binding KaraokeFontSize}"/>
                    <TextBlock Text="窗口透明度" Style="{StaticResource SettingLabel}"/>
                    <Slider Minimum="0.3" Maximum="1.0" Value="{Binding KaraokeOpacity}"/>
                    <CheckBox IsChecked="{Binding KaraokeUseBackgroundColor}" Content="使用专辑封面色作为背景"/>
                    <TextBlock Text="歌词偏移（毫秒）" Style="{StaticResource SettingLabel}"/>
                    <Slider Minimum="-2000" Maximum="2000" Value="{Binding LyricOffsetMs}"/>
                </StackPanel>
            </TabItem>

            <!-- 通用 -->
            <TabItem Header="通用">
                <StackPanel Margin="12">
                    <CheckBox IsChecked="{Binding LaunchAtStartup}" Content="开机自动启动"/>
                    <TextBlock Text="数据目录：%APPDATA%\LyricFever" Style="{StaticResource SettingLabel}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Click="OnSaveClicked"/>
        </StackPanel>
    </Grid>
</Window>
