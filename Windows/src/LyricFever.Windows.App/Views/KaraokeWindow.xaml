<Window x:Class="LyricFever.Windows.App.Views.KaraokeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyric Fever 歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="520" Height="100"
        WindowStartupLocation="Manual"
        PreviewMouseLeftButtonDown="OnBorderMouseDown"
        PreviewMouseLeftButtonUp="OnBorderMouseUp"
        PreviewMouseMove="OnBorderMouseMove"
        LostMouseCapture="OnBorderLostMouseCapture">
    <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="0"
            Background="#D9212128"
            Loaded="OnRootLoaded">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="隐藏歌词窗口" Click="OnHideClicked"/>
                <MenuItem Header="设置" Click="OnSettingsClicked"/>
                <MenuItem Header="退出" Click="OnQuitClicked"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="20,12">
            <TextBlock x:Name="PlaceholderNote"
                       Text="♪"
                       FontFamily="Segoe UI Symbol"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel x:Name="LyricContent"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Effect>
                    <DropShadowEffect Color="#CC000000" BlurRadius="4" ShadowDepth="1" Opacity="0.65"/>
                </StackPanel.Effect>
                <TextBlock x:Name="PrimaryLine"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RomanizedLine"
                           Margin="0,3,0,0"
                           Foreground="#D1FFFFFF"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TranslatedLine"
                           Margin="0,3,0,0"
                           Foreground="#C7FFFFFF"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
