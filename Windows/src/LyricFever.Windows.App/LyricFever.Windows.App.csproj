<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LyricFever.Core\LyricFever.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Kawazu" Version="1.1.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LyricFever</AssemblyName>
    <RootNamespace>LyricFever.Windows.App</RootNamespace>
    <MeCabUseDefaultDictionary>True</MeCabUseDefaultDictionary>
  </PropertyGroup>

  <!-- LibNMeCab.IpaDicBin 0.10.0 的旧式 targets 在 SDK 项目不生效：
       手动从 NuGet 缓存复制 IPAdic 词典到输出目录（build 与 publish 均复制）。 -->
  <Target Name="CopyIpaDic" AfterTargets="Build;Publish">
    <PropertyGroup>
      <IpaDicSource>$(NuGetPackageRoot)libnmecab.ipadicbin\0.10.0\content\IpaDic</IpaDicSource>
      <IpaDicTarget Condition="'$(PublishDir)' != ''">$(PublishDir)IpaDic</IpaDicTarget>
      <IpaDicTarget Condition="'$(PublishDir)' == ''">$(OutDir)IpaDic</IpaDicTarget>
    </PropertyGroup>
    <ItemGroup>
      <IpaDicFiles Include="$(IpaDicSource)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(IpaDicFiles)" DestinationFolder="$(IpaDicTarget)"
          Condition="Exists('$(IpaDicSource)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
